{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yisiui/design-system/registry",
  "type": "object",
  "required": ["schemaVersion", "surface", "namespace", "assets"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "surface": { "type": "string", "minLength": 1 },
    "namespace": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "status", "distribution", "release", "capabilities", "slots", "aliases", "useWhen", "doNotUseWhen", "similarAssetsChecked", "differenceSummary"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
          "category": { "type": "string", "minLength": 1 },
          "status": { "enum": ["candidate", "experimental", "stable", "deprecated", "removed"] },
          "source": { "type": "string", "minLength": 1 },
          "storyId": { "type": "string", "minLength": 1 },
          "distribution": { "const": "source-sync" },
          "release": { "type": "string", "minLength": 1 },
          "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "slots": { "type": "array", "items": { "type": "string" } },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "useWhen": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "doNotUseWhen": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "similarAssetsChecked": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "differenceSummary": { "type": "string", "minLength": 1 },
          "migration": { "$ref": "#/$defs/assetMigration" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "removed" } }, "required": ["status"] },
            "then": {
              "required": ["migration"],
              "properties": {
                "migration": { "required": ["removedIn"] }
              },
              "not": {
                "anyOf": [
                  { "required": ["source"] },
                  { "required": ["storyId"] }
                ]
              }
            },
            "else": { "required": ["source", "storyId"] }
          },
          {
            "if": { "properties": { "status": { "const": "deprecated" } }, "required": ["status"] },
            "then": {
              "required": ["migration"],
              "properties": {
                "migration": { "not": { "required": ["removedIn"] } }
              }
            }
          },
          {
            "if": {
              "properties": { "status": { "enum": ["deprecated", "removed"] } },
              "required": ["status"]
            },
            "else": { "not": { "required": ["migration"] } }
          }
        ]
      }
    }
  },
  "$defs": {
    "assetMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "replacement", "deprecatedSince", "removeAfter", "migrationGuide"],
      "properties": {
        "kind": { "enum": ["replace", "merge", "rename", "remove"] },
        "replacement": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$" },
            { "type": "null" }
          ]
        },
        "deprecatedSince": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "removeAfter": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "removedIn": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "migrationGuide": { "type": "string", "minLength": 1 },
        "legacyImportNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "remove" } }, "required": ["kind"] },
          "else": { "properties": { "replacement": { "type": "string" } } }
        }
      ]
    }
  }
}
