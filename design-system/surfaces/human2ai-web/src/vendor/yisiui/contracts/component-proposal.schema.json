{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yisiui/component-proposal",
  "oneOf": [
    { "$ref": "#/$defs/legacyProposal" },
    { "$ref": "#/$defs/readyCandidateProposal" }
  ],
  "$defs": {
    "legacyProposal": {
      "type": "object",
      "required": ["schemaVersion", "id", "status", "originProject", "source", "proposedName", "capabilities", "slots", "useWhen", "doNotUseWhen", "similarAssetsChecked", "differenceSummary", "dependencies", "couplingToRemove"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": { "const": "candidate" },
        "originProject": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "proposedName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "slots": { "type": "array", "items": { "type": "string" } },
        "useWhen": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "doNotUseWhen": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "similarAssetsChecked": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "differenceSummary": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "couplingToRemove": { "type": "array", "items": { "type": "string" } }
      }
    },
    "readyCandidateProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schemaVersion", "id", "status", "originProject", "surface", "candidateRoot", "entry", "proposedName", "capabilities", "slots", "useWhen", "doNotUseWhen", "similarAssetsChecked", "differenceSummary", "dependencies", "decoupling"],
      "properties": {
        "$schema": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": 2 },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "status": { "const": "candidate" },
        "originProject": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "surface": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "candidateRoot": {
          "type": "string",
          "pattern": "^design-system/surfaces/[a-z0-9-]+/candidates/[a-z0-9-]+$"
        },
        "entry": { "$ref": "#/$defs/relativePath" },
        "proposedName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
        "capabilities": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "slots": { "$ref": "#/$defs/uniqueStrings" },
        "useWhen": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "doNotUseWhen": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "similarAssetsChecked": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "differenceSummary": { "type": "string", "minLength": 1 },
        "dependencies": { "$ref": "#/$defs/uniqueStrings" },
        "decoupling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectImportsRemoved", "productCopyExternalized", "productTokensRemoved", "businessStateExternalized"],
          "properties": {
            "projectImportsRemoved": { "const": true },
            "productCopyExternalized": { "const": true },
            "productTokensRemoved": { "const": true },
            "businessStateExternalized": { "const": true }
          }
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\.\\.(?:/|$))" }
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
