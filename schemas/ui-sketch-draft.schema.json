{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yisi.local/schemas/ui-sketch-draft.schema.json",
  "title": "UI Sketch Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "frame", "overallNote", "rectangles", "texts", "images", "groups", "stages"],
  "properties": {
    "pngSplits": { "type": "array", "items": { "$ref": "#/$defs/pngSplit" } },
    "layerOrder": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "version": { "const": 1 },
    "kind": { "const": "ui-layout-draft" },
    "frame": { "$ref": "#/$defs/bounds" },
    "overallNote": { "type": "string" },
    "stateTabs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "number": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "itemIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "itemIds": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "rectangles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "width", "height", "note", "annotation", "semanticType", "origin", "visible", "weight"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "note": { "type": "string" },
          "annotation": { "type": "string" },
          "semanticType": { "type": "string" },
          "origin": { "enum": ["user", "agent", "import"] },
          "visible": { "type": "boolean" },
          "weight": {
            "enum": ["auto", "high", "medium", "low", "decorative"]
          }
        }
      }
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "text", "fontSize", "note", "annotation", "semanticType", "origin", "visible", "weight"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "text": { "type": "string" },
          "fontSize": { "type": "number", "exclusiveMinimum": 0 },
          "note": { "type": "string" },
          "annotation": { "type": "string" },
          "semanticType": { "type": "string" },
          "origin": { "enum": ["user", "agent", "import"] },
          "visible": { "type": "boolean" },
          "weight": {
            "enum": ["auto", "high", "medium", "low", "decorative"]
          }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "width", "height", "assetId", "crop", "note", "annotation", "semanticType", "origin", "visible", "weight"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "previewReference": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sessionId",
                  "sessionType",
                  "cameraId",
                  "renderedRevision"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sessionType": {
                    "const": "spatial"
                  },
                  "cameraId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "renderedRevision": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sessionId",
                  "sessionType",
                  "stateId",
                  "renderedRevision"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sessionType": {
                    "const": "ui-layout"
                  },
                  "stateId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "renderedRevision": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sessionId",
                  "sessionType",
                  "stateId",
                  "renderedRevision"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sessionType": {
                    "const": "image-composition"
                  },
                  "stateId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "renderedRevision": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          },
          "assetId": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "crop": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/imageCrop" }
            ]
          },
          "note": { "type": "string" },
          "annotation": { "type": "string" },
          "semanticType": { "type": "string" },
          "origin": { "enum": ["user", "agent", "import"] },
          "visible": { "type": "boolean" },
          "weight": {
            "enum": ["auto", "high", "medium", "low", "decorative"]
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rectangles", "texts", "images"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "not": { "const": "start" } },
          "rectangles": {
            "type": "array",
            "items": { "$ref": "#/$defs/stageRectangle" }
          },
          "texts": {
            "type": "array",
            "items": { "$ref": "#/$defs/stageText" }
          },
          "images": {
            "type": "array",
            "items": { "$ref": "#/$defs/stageRectangle" }
          }
        }
      }
    }
  },
  "$defs": {
    "pngSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "algorithm",
        "packingAlgorithm",
        "options",
        "sources",
        "pieces",
        "groupId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "enum": [
            "alpha-threshold-soft-edges-8-connected-v2",
            "alpha-threshold-manual-regions-v3"
          ]
        },
        "packingAlgorithm": {
          "const": "native-size-skyline-v1"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alphaThreshold",
            "minSize",
            "gap"
          ],
          "properties": {
            "alphaThreshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 254
            },
            "minSize": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "gap": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId",
              "assetId",
              "sha256",
              "width",
              "height",
              "discarded"
            ],
            "properties": {
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "assetId": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "discarded": {
                "type": "integer",
                "minimum": 0
              },
              "regions": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 256,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  }
                }
              }
            }
          }
        },
        "pieces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId",
              "assetId",
              "sourceNodeId",
              "sourceRect",
              "sha256",
              "width",
              "height"
            ],
            "properties": {
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "assetId": {
                "type": "string",
                "minLength": 1
              },
              "sourceNodeId": {
                "type": "string",
                "minLength": 1
              },
              "sourceRect": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "groupId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "imageCrop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "stageRectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height", "visible"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "visible": { "type": "boolean" }
      }
    },
    "stageText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "fontSize", "visible"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "visible": { "type": "boolean" }
      }
    }
  }
}
