{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yisi.local/schemas/spatial-operations.schema.json",
  "type": "array",
  "maxItems": 100,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "enabled"
        ],
        "properties": {
          "type": {
            "const": "set-lighting"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "name"
        ],
        "properties": {
          "type": {
            "const": "add-character"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "height": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 20
          },
          "headRatio": {
            "type": "number",
            "minimum": 2,
            "maximum": 12
          },
          "torsoRatio": {
            "type": "number",
            "minimum": 0.3,
            "maximum": 0.7
          },
          "bodyType": {
            "enum": [
              "male",
              "female"
            ]
          },
          "neckLength": {
            "type": "number",
            "minimum": 0.6,
            "maximum": 1.4
          },
          "palmSize": {
            "type": "number",
            "minimum": 0.7,
            "maximum": 1.3
          },
          "fingerLength": {
            "type": "number",
            "minimum": 0.6,
            "maximum": 1.4
          },
          "footSize": {
            "type": "number",
            "minimum": 0.7,
            "maximum": 1.4
          },
          "appearance": {
            "enum": [
              "quaternius",
              "geometric"
            ]
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "character"
        ],
        "properties": {
          "type": {
            "const": "put-character"
          },
          "character": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "position",
              "rotation",
              "height",
              "headRatio",
              "color",
              "joints",
              "bones",
              "appearance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "humanoid",
                  "custom"
                ]
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "height": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 20
              },
              "headRatio": {
                "type": "number",
                "minimum": 2,
                "maximum": 12
              },
              "thumbLimitsVersion": {
                "const": 2
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "joints": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "parentId",
                    "offset",
                    "lockPosition",
                    "radius",
                    "terminal"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "parentId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "offset": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -10000,
                        "maximum": 10000
                      }
                    },
                    "lockPosition": {
                      "type": "boolean"
                    },
                    "radius": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 10
                    },
                    "terminal": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "bones": {
                "type": "array",
                "maxItems": 199,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "startJointId",
                    "endJointId",
                    "rotation",
                    "restRotation",
                    "limits",
                    "lockRotation",
                    "modelPart"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "startJointId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "endJointId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "rotation": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -10000,
                        "maximum": 10000
                      }
                    },
                    "restRotation": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number",
                        "minimum": -10000,
                        "maximum": 10000
                      }
                    },
                    "limits": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "min",
                        "max"
                      ],
                      "properties": {
                        "min": {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "items": {
                            "type": "number",
                            "minimum": -10000,
                            "maximum": 10000
                          }
                        },
                        "max": {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "items": {
                            "type": "number",
                            "minimum": -10000,
                            "maximum": 10000
                          }
                        }
                      }
                    },
                    "lockRotation": {
                      "type": "boolean"
                    },
                    "modelPart": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  }
                }
              },
              "appearance": {
                "enum": [
                  "quaternius",
                  "geometric"
                ]
              },
              "torsoRatio": {
                "type": "number",
                "minimum": 0.3,
                "maximum": 0.7
              },
              "bodyType": {
                "enum": [
                  "male",
                  "female"
                ]
              },
              "neckLength": {
                "type": "number",
                "minimum": 0.6,
                "maximum": 1.4
              },
              "palmSize": {
                "type": "number",
                "minimum": 0.7,
                "maximum": 1.3
              },
              "fingerLength": {
                "type": "number",
                "minimum": 0.6,
                "maximum": 1.4
              },
              "footSize": {
                "type": "number",
                "minimum": 0.7,
                "maximum": 1.4
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "characterId",
          "sourceJointId",
          "parentId",
          "idPrefix",
          "offset"
        ],
        "properties": {
          "type": {
            "const": "add-limb"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sourceJointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "parentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "idPrefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "offset": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "characterId",
          "height",
          "headRatio"
        ],
        "properties": {
          "type": {
            "const": "set-proportions"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "height": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 20
          },
          "headRatio": {
            "type": "number",
            "minimum": 2,
            "maximum": 12
          },
          "torsoRatio": {
            "type": "number",
            "minimum": 0.3,
            "maximum": 0.7
          },
          "bodyType": {
            "enum": [
              "male",
              "female"
            ]
          },
          "neckLength": {
            "type": "number",
            "minimum": 0.6,
            "maximum": 1.4
          },
          "palmSize": {
            "type": "number",
            "minimum": 0.7,
            "maximum": 1.3
          },
          "fingerLength": {
            "type": "number",
            "minimum": 0.6,
            "maximum": 1.4
          },
          "footSize": {
            "type": "number",
            "minimum": 0.7,
            "maximum": 1.4
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "characterId",
          "jointId",
          "position"
        ],
        "properties": {
          "type": {
            "const": "move-joint"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "jointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "characterId",
          "jointId",
          "position"
        ],
        "properties": {
          "type": {
            "const": "lock-joint"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "jointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "position": {
            "type": "boolean"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "object"
        ],
        "properties": {
          "type": {
            "const": "put-object"
          },
          "object": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kind",
              "position",
              "rotation",
              "size",
              "color"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "box",
                  "sphere",
                  "plane"
                ]
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "size": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "camera"
        ],
        "properties": {
          "type": {
            "const": "put-camera"
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "position",
              "target",
              "projection",
              "fov",
              "span",
              "width",
              "height",
              "background"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "target": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "projection": {
                "enum": [
                  "perspective",
                  "orthographic"
                ]
              },
              "fov": {
                "type": "number",
                "minimum": 10,
                "maximum": 120
              },
              "span": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 1000
              },
              "width": {
                "type": "integer",
                "minimum": 128,
                "maximum": 2048
              },
              "height": {
                "type": "integer",
                "minimum": 128,
                "maximum": 2048
              },
              "background": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "const": "remove"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "characterId",
          "boneId",
          "rotation"
        ],
        "properties": {
          "type": {
            "const": "rotate-bone"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "boneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "rotation": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10000,
              "maximum": 10000
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "characterId",
          "boneId",
          "rotation"
        ],
        "properties": {
          "type": {
            "const": "lock-bone"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "boneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "rotation": {
            "type": "boolean"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "characterId",
          "boneId",
          "limits"
        ],
        "properties": {
          "type": {
            "const": "set-bone-limits"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "boneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "max": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "characterId"
        ],
        "properties": {
          "type": {
            "const": "reset-pose"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "characterId",
          "handBoneId"
        ],
        "properties": {
          "type": {
            "const": "pose-hand"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "handBoneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "curl": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "thumb": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "index": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "middle": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ring": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "little": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "spread": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "thumbOpposition": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "curl"
            ]
          },
          {
            "required": [
              "spread"
            ]
          },
          {
            "required": [
              "thumbOpposition"
            ]
          }
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "characterId",
          "handBoneId"
        ],
        "properties": {
          "type": {
            "const": "reset-hand"
          },
          "characterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "handBoneId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "box"
        ],
        "properties": {
          "type": {
            "const": "put-camera-box"
          },
          "box": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "position",
              "rotation",
              "size",
              "resolution"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                }
              },
              "size": {
                "type": "number",
                "minimum": 0.05,
                "maximum": 1000
              },
              "resolution": {
                "type": "integer",
                "minimum": 128,
                "maximum": 1024
              }
            }
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "region"
        ],
        "properties": {
          "type": {
            "const": "fit-camera-box"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "region": {
