{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "styles.d.ts",
    ".storybook/**/*.ts",
    "stories/**/*.tsx",
    "../design-system/surfaces/human2ai-web/src/local/**/*.stories.tsx"
  ],
  "exclude": [
    "node_modules",
    "storybook-static"
  ]
}
