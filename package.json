{
  "name": "human2ai",
  "version": "0.1.1",
  "description": "Local visual collaboration workspace for people and AI agents, with a browser UI and CLI.",
  "license": "MIT",
  "author": "贾思斋",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yisi-ai/human2ai.git"
  },
  "homepage": "https://github.com/yisi-ai/human2ai#readme",
  "bugs": "https://github.com/yisi-ai/human2ai/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "human2ai": "./dist/cli/main.js",
    "h2a": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "web/out",
    "migrations",
    "schemas",
    "skills/human2ai",
    "locales/en/common.json",
    "licenses",
    "assets/quaternius"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11",
  "workspaces": [
    "web",
    "design-system/surfaces/*",
    "storybook"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace web",
    "cli": "tsx src/cli/main.ts",
    "server:dev": "tsx watch src/server/start.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:server:watch": "tsc -p tsconfig.build.json --watch",
    "build:web": "npm run build --workspace web",
    "prepack": "npm run build && node scripts/prepare-package.mjs && node scripts/check-package.mjs",
    "pack:check": "npm run prepack",
    "repository:check": "node scripts/check-repository.mjs",
    "typecheck": "npm run typecheck:server && npm run typecheck:web && npm run storybook:typecheck",
    "typecheck:server": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "npm run typecheck --workspace web",
    "domain-baseline:check": "node scripts/domain-baseline.mjs check",
    "domain-baseline:test": "node scripts/domain-baseline.mjs test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "npm run storybook --workspace @human2ai/storybook",
    "storybook:build": "npm run build --workspace @human2ai/storybook",
    "storybook:typecheck": "npm run typecheck --workspace @human2ai/storybook",
    "yisiui": "node .yisiui/launcher.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.1",
    "saxes": "6.0.0",
    "sharp": "0.35.4",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.15.3",
    "@types/three": "0.185.0",
    "tsx": "4.23.12",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  }
}
